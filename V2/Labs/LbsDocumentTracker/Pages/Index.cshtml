@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}
<h1>Document dashboard</h1>
<p class="lead">Track fictional submissions through a local demonstration workflow.</p>
<p>Processing now validates a fictional application document. <strong>Completed</strong>
    means the training format passed, not that a financial application was approved.
    <strong>Needs review</strong> means its business fields need attention.</p>
<p><a class="button" asp-page="/Upload">Submit a fictional text document</a></p>

<section aria-labelledby="recent-heading">
    <h2 id="recent-heading">Recent documents</h2>
    @* The page model loads records from memory; an empty list means no submissions in this run. *@
    @if (Model.Documents.Count == 0)
    {
        <p>No documents submitted yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Reference</th><th>Status</th><th>Submitted (UTC)</th><th></th></tr></thead>
                <tbody>
                @foreach (var document in Model.Documents)
                {
                    <tr>
                        <td>@document.Reference</td>
                        <td><span class="status">@document.Status</span></td>
                        <td>@document.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><a asp-page="/Documents/Details" asp-route-id="@document.Id">View status</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>