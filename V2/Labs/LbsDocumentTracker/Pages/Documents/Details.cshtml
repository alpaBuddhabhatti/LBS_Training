@page "{id:guid}"
@model DetailsModel
@{
    ViewData["Title"] = "Document status";
}
<h1>Document status</h1>
@* A link can outlive the process: records exist only in the current in-memory session. *@
@if (Model.Document is null)
{
    <p class="validation" role="alert">This document was not found in the current local session. In-memory records disappear when the app stops.</p>
}
else
{
    <dl class="details">
        <dt>Fictional reference</dt><dd>@Model.Document.Reference</dd>
        <dt>Status</dt><dd><span class="status">@Model.Document.Status</span></dd>
        <dt>Submitted (UTC)</dt><dd>@Model.Document.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        @if (Model.Document.CompletedAt is not null)
        {
            <dt>Finished (UTC)</dt><dd>@Model.Document.CompletedAt.Value.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        }
    </dl>
    @if (Model.Document.ResultSummary is not null)
    {
        <p>@Model.Document.ResultSummary</p>
    }
    @if (Model.Document.Error is not null)
    {
        <p class="validation" role="alert">@Model.Document.Error</p>
    }
}
<p><a asp-page="/Index">Back to dashboard</a></p>