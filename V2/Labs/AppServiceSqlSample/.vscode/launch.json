{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug AppServiceSqlSample",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build AppServiceSqlSample project",
            "program": "${workspaceFolder}\\bin\\Debug\\net10.0\\AppServiceSqlSample.dll",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "DOTNET_ENVIRONMENT": "Development",
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5080"
            }
        }
    ]
}
