{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build AppServiceSqlSample project",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}\\AppServiceSqlSample.csproj",
                "/property:GenerateFullPaths=true",
                "/p:Configuration=Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
