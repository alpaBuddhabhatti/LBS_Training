{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build dummy tracker",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}\\DummyDocumentTracker.csproj"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Publish dummy tracker",
      "type": "process",
      "command": "dotnet",
      "args": ["publish", "${workspaceFolder}\\DummyDocumentTracker.csproj", "-c", "Release", "-o", "${workspaceFolder}\\publish"],
      "problemMatcher": "$msCompile"
    }
  ]
}
