{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run dummy tracker locally",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build dummy tracker",
      "program": "${workspaceFolder}\\bin\\Debug\\net10.0\\DummyDocumentTracker.dll",
      "cwd": "${workspaceFolder}",
      "args": ["--urls", "http://localhost:5203"],
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  ]
}
